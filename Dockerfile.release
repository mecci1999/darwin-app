# Keep the certificate bundle in every build stage. The slim Node image does
# not include it, which prevents apt from validating the HTTPS Tencent mirror.
FROM node:22.14.0-bookworm AS base
WORKDIR /app
# Tencent Cloud's Debian mirror is materially faster and more reliable from the production CVM.
RUN sed -i \
      -e 's|http://deb.debian.org/debian-security|http://mirrors.cloud.tencent.com/debian-security|g' \
      -e 's|http://deb.debian.org/debian|http://mirrors.cloud.tencent.com/debian|g' \
      /etc/apt/sources.list.d/debian.sources \
    && corepack enable

FROM base AS dependencies
RUN apt-get update \
    && apt-get install --no-install-recommends -y python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY darwin-app/package.json darwin-app/pnpm-lock.yaml darwin-app/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM dependencies AS builder
COPY darwin-app/tsconfig.json darwin-app/tsconfig.build.json ./
COPY darwin-app/src ./src
COPY shared/trails-contract /shared/trails-contract
RUN pnpm run build:all

FROM dependencies AS production-dependencies
RUN pnpm prune --prod
COPY node-universe/dist /tmp/node-universe-dist
COPY darwin-app/docker/patch-node-universe-runtime.js /tmp/patch-node-universe-runtime.js
RUN node /tmp/patch-node-universe-runtime.js /tmp/node-universe-dist \
    && rm -rf /tmp/node-universe-dist /tmp/patch-node-universe-runtime.js

FROM base AS runtime
ENV NODE_ENV=production
RUN apt-get update \
    && apt-get install --no-install-recommends -y util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/uploads \
    && chown node:node /app/uploads
COPY --from=production-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/dist ./dist
COPY --from=builder --chown=node:node /shared/trails-contract /shared/trails-contract
COPY --chown=node:node darwin-app/scripts ./scripts
COPY darwin-app/docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod 755 /usr/local/bin/docker-entrypoint
EXPOSE 6670 8090
ENTRYPOINT ["/usr/local/bin/docker-entrypoint"]
CMD ["node", "dist/core/gateway/index.js"]
