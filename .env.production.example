# Copy this file to a protected server-side .env.production and replace every CHANGE_ME value.
# Never commit the populated file. Docker service names below are intentional.
NODE_ENV=production
APP_IMAGE=darwin-app:CHANGE_ME
# Mirror production infrastructure images into your controlled registry. Pin by digest after verification.
ZOOKEEPER_IMAGE=ccr.ccs.tencentyun.com/starlight/zookeeper@sha256:CHANGE_ME
KAFKA_IMAGE=ccr.ccs.tencentyun.com/starlight/kafka@sha256:CHANGE_ME
MYSQL_IMAGE=ccr.ccs.tencentyun.com/starlight/mysql@sha256:CHANGE_ME
REDIS_IMAGE=ccr.ccs.tencentyun.com/starlight/redis@sha256:CHANGE_ME
INFLUXDB_IMAGE=ccr.ccs.tencentyun.com/starlight/influxdb@sha256:CHANGE_ME
ELASTICSEARCH_IMAGE=ccr.ccs.tencentyun.com/starlight/elasticsearch@sha256:CHANGE_ME

GATEWAY_PORT=6670
WS_SERVER_PORT=8090
WS_SERVER_PATH=/ws
# Default 0: return the existing 503 envelope immediately when the target service
# is absent from the Kafka/Node-Universe registry. Set positive only for bounded startup grace.
GATEWAY_SERVICE_WAIT_TIMEOUT_MS=0
GATEWAY_SERVICE_WAIT_INTERVAL_MS=500
# Bounded deadline for ordinary downstream RPCs. The long-lived logs SSE route is exempt.
GATEWAY_RPC_TIMEOUT_MS=15000
NODE_INSTANCE_ID=
API_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
# Comma-separated exact HTTPS browser origins. Wildcards are rejected because CORS uses credentials.
# Include the separately deployed public photography site when it reads public Trails archives.
CORS_ALLOWED_ORIGINS=https://app.example.com,https://portfolio.example.com
MICRO_APP_TICKET_SECRET=CHANGE_ME

# Durable Trails MySQL metadata composition. Only the exact value "true" enables it.
# Apply the required Trails schema migrations before startup. Disabled v2 stores return 503 and never fall back to v1 memory.
# TRAILS_DURABLE_CATEGORY_SYNC is a legacy fallback only; setting both flags with conflicting enabled values fails closed.
TRAILS_DURABLE_PERSISTENCE_ENABLED=true
# Creator-space membership is database-authoritative. Apply migration 020 before deploying
# Trails workspace access; no environment variable can bootstrap or bypass memberships.
# Operations-only provisioning (run `pnpm bootstrap:trails-creator-membership` after migrations
# and before granting workspace access; do not leave these values in the service environment):
# TRAILS_CREATOR_BOOTSTRAP_TENANT_ID=tenant-id
# TRAILS_CREATOR_BOOTSTRAP_USER_ID=active-user-id
# TRAILS_CREATOR_BOOTSTRAP_ROLE=creator-space-owner
# For an editor, set TRAILS_CREATOR_BOOTSTRAP_ASSIGNED_OWNER_USER_ID to an active user in the same tenant.
# That owner must already be an active owner member unless the one-time, explicit safe policy
# TRAILS_CREATOR_BOOTSTRAP_ALLOW_OWNER_CREATE=true is set; it creates only a missing owner membership.
# Public Trails media delivery is intentionally deferred and unsupported. Do not configure a public origin, CDN, signed URL, download, or TRAILS_MEDIA_PUBLIC_DELIVERY_BASE.
# Durable public photography archive. These stay server-side: browsers must never choose a tenant or owner.
# Set both IDs to the reviewed creator-space owner before exposing /api/trails/v2/categories/public
# or /api/trails/v2/portfolios/public in production.
TRAILS_PUBLIC_OWNER_TENANT_ID=CHANGE_ME
TRAILS_PUBLIC_OWNER_USER_ID=CHANGE_ME
# Trails COS connectivity verification is disabled by default and has no public action.
# static-env and sts-env credentials are deliberately local/development/test-only;
# production remains disabled pending a separately reviewed server-identity provider.
# An sts-env token must be short-lived. Never place real secrets here.
TRAILS_COS_ENABLED=false
TRAILS_COS_CREDENTIAL_PROVIDER=static-env
TRAILS_COS_SECRET_ID=SET_ONLY_IN_PROTECTED_LOCAL_ENV
TRAILS_COS_SECRET_KEY=SET_ONLY_IN_PROTECTED_LOCAL_ENV
TRAILS_COS_SECURITY_TOKEN=SET_ONLY_IN_PROTECTED_LOCAL_ENV_SHORT_LIVED
# Private Photoshop ingestion also fails closed in production pending a reviewed server-identity provider.
# COS x-cos-forbid-overwrite create-only protection is effective only when bucket versioning is disabled.
TRAILS_COS_INGESTION_ENABLED=false
TRAILS_COS_INGESTION_MAPPING_SECRET=SET_ONLY_IN_PROTECTED_LOCAL_ENV
# Disabled in production. This readiness preflight neither enables an ingestion writer
# nor accepts versioning states; only explicit no-versioning configuration is eligible.
TRAILS_COS_INGESTION_VERSIONING_PREFLIGHT_ENABLED=false

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=darwin_app
MYSQL_USER=darwin
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# The single-node Kafka broker is intentionally internal-only and uses PLAINTEXT.
# Leave credentials empty unless the broker is intentionally switched to SASL.
KAFKA_BROKERS=kafka:29092
KAFKA_HOST=kafka:29092
KAFKA_USER=
KAFKA_PASSWORD=

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USERNAME=darwin
INFLUXDB_PASSWORD=CHANGE_ME
INFLUXDB_ORG=darwin
INFLUXDB_BUCKET=metrics
INFLUXDB_TOKEN=CHANGE_ME

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

PASSWORD_SECRET_KEY=CHANGE_ME
TOKEN_SECRET_KET=CHANGE_ME
ADMIN_EMAILS=ops@example.com
QR_CODE_EXPIRE=120
TOKEN_EXIPRE_TIME=6h
REFRESH_TOKEN_EXIPRE_TIME=3d

# Verification email delivery. Keep SMTP_PASSWORD only in the protected .env.production.
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASSWORD=CHANGE_ME
FROM_EMAIL=noreply@example.com
FROM_NAME=星光
VERIFY_CODE_EMAIL_TIMEOUT_MS=5000
