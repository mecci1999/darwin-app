# Copy this file to a protected server-side .env.production and replace every CHANGE_ME value.
# Never commit the populated file. Docker service names below are intentional.
NODE_ENV=production
APP_IMAGE=darwin-app:CHANGE_ME

GATEWAY_PORT=6670
WS_SERVER_PORT=8090
WS_SERVER_PATH=/ws
NODE_INSTANCE_ID=

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=darwin_app
MYSQL_USER=darwin
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# The single-node Kafka broker is intentionally internal-only and uses PLAINTEXT.
KAFKA_BROKERS=kafka:29092
KAFKA_HOST=kafka:29092
KAFKA_USER=
KAFKA_PASSWORD=

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USERNAME=darwin
INFLUXDB_PASSWORD=CHANGE_ME
INFLUXDB_ORG=darwin
INFLUXDB_BUCKET=metrics
INFLUXDB_TOKEN=CHANGE_ME

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

PASSWORD_SECRET_KEY=CHANGE_ME
TOKEN_SECRET_KET=CHANGE_ME
ADMIN_EMAILS=ops@example.com
QR_CODE_EXPIRE=120
TOKEN_EXIPRE_TIME=6h
REFRESH_TOKEN_EXIPRE_TIME=3d
