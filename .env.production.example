# Copy this file to a protected server-side .env.production and replace every CHANGE_ME value.
# Never commit the populated file. Docker service names below are intentional.
NODE_ENV=production
APP_IMAGE=darwin-app:CHANGE_ME
# Mirror production infrastructure images into your controlled registry. Pin by digest after verification.
ZOOKEEPER_IMAGE=ccr.ccs.tencentyun.com/starlight/zookeeper@sha256:CHANGE_ME
KAFKA_IMAGE=ccr.ccs.tencentyun.com/starlight/kafka@sha256:CHANGE_ME
MYSQL_IMAGE=ccr.ccs.tencentyun.com/starlight/mysql@sha256:CHANGE_ME
REDIS_IMAGE=ccr.ccs.tencentyun.com/starlight/redis@sha256:CHANGE_ME
INFLUXDB_IMAGE=ccr.ccs.tencentyun.com/starlight/influxdb@sha256:CHANGE_ME
ELASTICSEARCH_IMAGE=ccr.ccs.tencentyun.com/starlight/elasticsearch@sha256:CHANGE_ME

GATEWAY_PORT=6670
WS_SERVER_PORT=8090
WS_SERVER_PATH=/ws
# Used only before the Gateway registry watchdog has its first snapshot. Once the
# watchdog is available, a never-seen target returns 503 immediately; a recently
# seen target gets the bounded directory refresh below instead.
GATEWAY_SERVICE_WAIT_TIMEOUT_MS=0
GATEWAY_SERVICE_WAIT_INTERVAL_MS=500
# A recently seen service that briefly disappears from this Gateway's local Kafka
# directory gets one coalesced DISCOVER and short polling window. This does not
# mark it healthy until a real registry entry returns, and cannot hide a true outage.
GATEWAY_TRANSIENT_SERVICE_REFRESH_TIMEOUT_MS=2000
GATEWAY_TRANSIENT_SERVICE_REFRESH_INTERVAL_MS=100
GATEWAY_TRANSIENT_SERVICE_REFRESH_COOLDOWN_MS=1000
# Comma-separated Node-Universe services required for Gateway readiness. Keep this aligned
# with the deployed topology; a missing service keeps /api/ready unavailable and triggers
# a bounded DISCOVER reconciliation. A persistent non-critical stale view can then
# terminate Gateway once so Compose recreates its Kafka consumer and registry view.
GATEWAY_REQUIRED_SERVICES=gateway,auth,user,file,metrics,metrics-query,metrics-alerts,metrics-compat,metrics-lifecycle,logs,subscription,subscription-billing,micro-app,video,trails-durable-content,trails-durable-media,trails-durable-workspace,trails-durable-trips,trails-durable-site,trails-durable-site-public,trails-durable-sales,trails-durable-field-plans,trails-durable-shooting
# Successful directory reconciliation failures with the same gap before Gateway exits once.
GATEWAY_REGISTRY_RECOVERY_EXIT_THRESHOLD=4
# If several recently seen services disappear from Gateway's local directory at once,
# treat it as a local directory drift even when some are critical, then restart only
# Gateway after the bounded recovery threshold instead of reporting a permanent outage.
GATEWAY_REGISTRY_DIRECTORY_DRIFT_MISSING_SERVICE_THRESHOLD=3
# Bounded deadline for ordinary downstream RPCs. The long-lived logs SSE route is exempt.
GATEWAY_RPC_TIMEOUT_MS=15000
NODE_INSTANCE_ID=
API_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
# Comma-separated exact HTTPS browser origins. Wildcards are rejected because CORS uses credentials.
# Include the separately deployed public photography site when it reads public Trails archives.
CORS_ALLOWED_ORIGINS=https://app.example.com,https://portfolio.example.com
MICRO_APP_TICKET_SECRET=CHANGE_ME

# Unified Trails runtime image. It registers every supported Trails shard under the single `trails` deployment.
TRAILS_IMAGE=darwin-app:CHANGE_ME
# Durable Trails MySQL metadata composition. Only the exact value "true" enables it.
# Apply the required Trails schema migrations before startup. Disabled v2 stores return 503 and never fall back to v1 memory.
# TRAILS_DURABLE_CATEGORY_SYNC is a legacy fallback only; setting both flags with conflicting enabled values fails closed.
TRAILS_DURABLE_PERSISTENCE_ENABLED=true
# Required whenever durable Trails v2 is enabled. Generate a distinct 32-byte base64 value
# in the protected server-side .env.production; never commit it or reuse an application secret.
TRAILS_GUEST_COMMENT_NOTIFICATION_KEY=CHANGE_ME
# Private field weather is disabled unless at least one provider is configured.
# Keep every credential only in the protected production environment. The mobile app talks only
# to the authenticated Trails gateway and never receives a provider Key.
# Set the default to qweather or windy. Legacy TRAILS_WEATHER_PROVIDER remains accepted.
# TRAILS_WEATHER_DEFAULT_PROVIDER=windy
# QWeather API Host is shown under QWeather Console -> Settings. Copy its unique host exactly.
# TRAILS_QWEATHER_API_HOST=https://CHANGE_ME
# TRAILS_QWEATHER_API_KEY=CHANGE_ME
# Windy must have Point Forecast API scope. The forecast model is explicit so the
# photography surface can disclose the exact numerical model rather than claim generic accuracy.
# TRAILS_WINDY_API_KEY=CHANGE_ME
# TRAILS_WINDY_POINT_FORECAST_MODEL=ecmwf
# Optional only for an approved Windy-compatible staging endpoint. Production defaults to
# https://api.windy.com/api/point-forecast/v2 and must remain HTTPS.
# TRAILS_WINDY_POINT_FORECAST_API_URL=https://api.windy.com/api/point-forecast/v2
# Creator-space membership is database-authoritative. Apply migration 020 before deploying
# Trails workspace access; no environment variable can bootstrap or bypass memberships.
# Operations-only provisioning (run `pnpm bootstrap:trails-creator-membership` after migrations
# and before granting workspace access; do not leave these values in the service environment):
# TRAILS_CREATOR_BOOTSTRAP_TENANT_ID=tenant-id
# TRAILS_CREATOR_BOOTSTRAP_USER_ID=active-user-id
# TRAILS_CREATOR_BOOTSTRAP_ROLE=creator-space-owner
# For an editor, set TRAILS_CREATOR_BOOTSTRAP_ASSIGNED_OWNER_USER_ID to an active user in the same tenant.
# That owner must already be an active owner member unless the one-time, explicit safe policy
# TRAILS_CREATOR_BOOTSTRAP_ALLOW_OWNER_CREATE=true is set; it creates only a missing owner membership.
# Trails media delivery is disabled by default. The private COS origin and all masters/private
# derivatives remain private. Never configure a public bucket ACL, public origin URL, signed URL,
# object key, TRAILS_MEDIA_PUBLIC_DELIVERY_BASE, or any browser credential.
# Lighthouse uses the narrowly-scoped, server-only static key mode. Its Tencent policy must
# be limited to the fixed private/public Trails prefixes; do not expose these credentials.
TRAILS_MEDIA_PUBLICATION_ENABLED=false
# To enable the reviewed Lighthouse deployment, use the following server-only contract.
# Secret values belong only in the protected production environment and must never be committed,
# logged, supplied to a browser, or reused from a previously disclosed access key.
# Set TRAILS_MEDIA_SERVER_IDENTITY_MODE to static-scoped-key.
# Set TRAILS_COS_CREDENTIAL_PROVIDER to static-env.
# Set TRAILS_COS_SECRET_ID and TRAILS_COS_SECRET_KEY only in the protected production environment.
# Set TRAILS_COS_INGESTION_MAPPING_SECRET to a distinct random server secret.
# Set TRAILS_MEDIA_CDN_DISTRIBUTION_ID to the reviewed distribution identifier.
# Set TRAILS_MEDIA_COS_BUCKET_ID to starlight-media-prod-1313219189 and TRAILS_MEDIA_COS_REGION to ap-guangzhou.
# Set TRAILS_MEDIA_PUBLIC_DERIVATIVE_NAMESPACE to public-derivatives.
# Optionally set TRAILS_MEDIA_PUBLICATION_WORKER_INTERVAL_MS to 15000.
# Durable public photography archive. These stay server-side: browsers must never choose a tenant or owner.
# Set both IDs to the reviewed creator-space owner before exposing /api/trails/v2/categories/public
# or /api/trails/v2/portfolios/public in production.
TRAILS_PUBLIC_OWNER_TENANT_ID=CHANGE_ME
TRAILS_PUBLIC_OWNER_USER_ID=CHANGE_ME
# Keep these false until all commented media settings above have been configured and the
# prefix-limited IAM policy has been independently verified.
TRAILS_COS_ENABLED=false
TRAILS_COS_INGESTION_ENABLED=false
TRAILS_COS_INGESTION_VERSIONING_PREFLIGHT_ENABLED=false

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=darwin_app
MYSQL_USER=darwin
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# The single-node Kafka broker is intentionally internal-only and uses PLAINTEXT.
# Leave credentials empty unless the broker is intentionally switched to SASL.
KAFKA_BROKERS=kafka:29092
KAFKA_HOST=kafka:29092
KAFKA_USER=
KAFKA_PASSWORD=

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USERNAME=darwin
INFLUXDB_PASSWORD=CHANGE_ME
INFLUXDB_ORG=darwin
INFLUXDB_BUCKET=metrics
INFLUXDB_TOKEN=CHANGE_ME

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

PASSWORD_SECRET_KEY=CHANGE_ME
TOKEN_SECRET_KET=CHANGE_ME
ADMIN_EMAILS=ops@example.com
QR_CODE_EXPIRE=120
TOKEN_EXIPRE_TIME=6h
REFRESH_TOKEN_EXIPRE_TIME=3d

# Verification email delivery. Keep SMTP_PASSWORD only in the protected .env.production.
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASSWORD=CHANGE_ME
FROM_EMAIL=noreply@example.com
FROM_NAME=星光
VERIFY_CODE_EMAIL_TIMEOUT_MS=5000

# Public comment email verification and moderation. Keep disabled until the
# same SMTP settings above have been verified in the protected production env.
TRAILS_GUEST_COMMENT_SUBMISSION_ENABLED=false
TRAILS_PUBLIC_SITE_URL=https://www.starlight.host
