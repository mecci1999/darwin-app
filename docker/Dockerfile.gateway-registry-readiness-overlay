ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Keep the release boundary intentionally narrow: this image updates only the
# Gateway entrypoint plus local registry readiness and observability modules.
COPY dist/core/gateway/index.js /app/dist/core/gateway/index.js
COPY dist/core/gateway/registry-readiness.js /app/dist/core/gateway/registry-readiness.js
COPY dist/core/gateway/registry-observability.js /app/dist/core/gateway/registry-observability.js
