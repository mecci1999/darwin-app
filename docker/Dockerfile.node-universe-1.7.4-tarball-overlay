ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR /app

# Offline overlay: use the already verified npm tarball, avoiding registry access
# during production image builds.
COPY node-universe-1.7.4.tgz /tmp/node-universe-1.7.4.tgz
RUN rm -rf /app/node_modules/node-universe \
  && mkdir -p /app/node_modules/node-universe \
  && tar -xzf /tmp/node-universe-1.7.4.tgz -C /app/node_modules/node-universe --strip-components=1 \
  && rm -f /tmp/node-universe-1.7.4.tgz \
  && node -e "const v=require('node-universe/package.json').version; if (v !== '1.7.4') throw new Error('node-universe overlay failed: '+v);"

# Keep application code aligned with the validated local build, including
# Kafka lifecycle reporting modules used by every service bootstrap.
COPY dist /app/dist
COPY trails-contract /shared/trails-contract
