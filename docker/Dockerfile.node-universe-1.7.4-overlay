ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR /app

# Install the npm-published, integrity-verified framework patch without
# rebuilding the production base image or altering application dependencies.
RUN npm install --omit=dev --no-save --package-lock=false node-universe@1.7.4

# Keep application code aligned with the validated local build, including
# Kafka lifecycle reporting modules used by every service bootstrap.
COPY dist /app/dist
COPY trails-contract /shared/trails-contract
